Options -Indexes
DirectoryIndex index.php

# Block direct web access to non-public folders (each also has its own .htaccess).
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(app|storage|database|tests|docs|install_backup)(/|$) - [F,L]
RewriteRule ^(README\.md|\.git|\.env) - [F,L]
</IfModule>

<FilesMatch "\.(sql|log|lock|md|bak|sh|csv|env|ini)$">
  Require all denied
</FilesMatch>
