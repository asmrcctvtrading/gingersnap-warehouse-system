# WPMS Environment Configuration Template
#
# Instructions:
# 1. Copy this file to .env in the application root
# 2. Replace all CHANGE_THIS values with actual configuration
# 3. NEVER commit .env to version control
# 4. Keep .env outside the web-accessible directory
# 5. Set file permissions to 640 (readable by PHP, not by web browser)
#
# Generated: October 24, 2026
# Version: 1.0

################################################################################
# DATABASE CONFIGURATION
################################################################################

# Database host - usually 'localhost' for shared hosting, or specific IP for remote
DB_HOST=localhost

# Database name - created in cPanel MySQL Databases
# Default: yitrmcft_wpms (for Gingersnaps account)
DB_NAME=CHANGE_THIS_TO_YOUR_DATABASE_NAME

# Database user - created in cPanel MySQL Users
# Default: yitrmcft_wpms_user (must have SELECT, INSERT, UPDATE, DELETE privileges)
DB_USER=CHANGE_THIS_TO_YOUR_DB_USER

# Database user password - MUST BE STRONG
# Requirements: 20+ characters, mixed case, numbers, special characters
# Example: Abc123!@#$DefGhi456KLm789
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Database port - usually 3306 for MySQL/MariaDB
DB_PORT=3306

# Database character set
DB_CHARSET=utf8mb4

# Database collation
DB_COLLATION=utf8mb4_unicode_ci

################################################################################
# APPLICATION CONFIGURATION
################################################################################

# Environment: production, staging, or development
# Use 'production' for live system, 'staging' for testing, 'development' for local
APP_ENV=production

# Application debug mode - MUST be false in production
# When true, shows detailed error messages (security risk)
APP_DEBUG=false

# Application URL - used in redirects and links
# Example: https://asmrcctvtechnologies.com/warehouse-productivity/
APP_URL=https://asmrcctvtechnologies.com/warehouse-productivity/

# Application name - displayed in header and browser tab
APP_NAME=WPMS (Warehouse Productivity Monitoring System)

# Application version - for reference and support
APP_VERSION=1.0.0

################################################################################
# SESSION CONFIGURATION
################################################################################

# Session timeout in seconds
# 1800 = 30 minutes (recommended for security-sensitive warehouse operations)
SESSION_TIMEOUT=1800

# Session secure flag - must be true for HTTPS (required in production)
# When true: only send session cookie over HTTPS
SESSION_SECURE=true

# Session httponly flag - prevents JavaScript from accessing session cookie
# Must be true to prevent XSS attacks
SESSION_HTTPONLY=true

# Session samesite attribute - prevents CSRF attacks
# Options: Strict, Lax, None
# Recommend: Strict (prevents cross-site cookie access)
SESSION_SAMESITE=Strict

# Session save path - should be outside web-accessible directory
# Default: /home/username/storage/sessions/ or system temp directory
SESSION_SAVE_PATH=/path/to/storage/sessions/

################################################################################
# FILE UPLOAD CONFIGURATION
################################################################################

# Maximum upload file size in bytes
# 52428800 = 50 MB (recommended for CSV/Excel imports)
# Must match PHP settings: upload_max_filesize and post_max_size
MAX_UPLOAD_SIZE=52428800

# Allowed file types for imports (comma-separated MIME types)
ALLOWED_MIME_TYPES=text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel

# Allowed file extensions (comma-separated, lowercase)
ALLOWED_EXTENSIONS=csv,xlsx,xls

# Upload directory path - MUST be outside public_html for security
# Example: /home/username/storage/uploads/
UPLOAD_DIR=/path/to/storage/uploads/

# Temporary directory for processing uploads
TEMP_DIR=/path/to/storage/temp/

################################################################################
# LOGGING CONFIGURATION
################################################################################

# Log level - ERROR, WARNING, INFO, DEBUG (from least to most verbose)
# Recommend: WARNING for production (reduces disk I/O)
LOG_LEVEL=warning

# Log directory path - MUST be outside public_html
# Example: /home/username/storage/logs/
LOG_DIR=/path/to/storage/logs/

# Log file name (with date rotation)
# Format: YYYY-MM-DD-application.log
LOG_FILE=application.log

# Maximum log file size in MB before rotation
LOG_MAX_SIZE=10

# Number of log files to keep (older files deleted)
LOG_RETENTION=30

################################################################################
# BACKUP CONFIGURATION
################################################################################

# Backup directory path - MUST be outside public_html
# Example: /home/username/storage/backups/
BACKUP_DIR=/path/to/storage/backups/

# Automated backup frequency
# Options: daily, weekly, never
BACKUP_FREQUENCY=daily

# Backup time (24-hour format, local server time)
# Recommended: 2:00 AM (low-traffic time)
BACKUP_TIME=02:00

# Number of backups to keep
# Recommended: 7 daily + 4 weekly = 11 total
BACKUP_RETENTION=11

# Email notification for failed backups (optional)
# Leave empty to disable
BACKUP_NOTIFICATION_EMAIL=

################################################################################
# SECURITY CONFIGURATION
################################################################################

# Encryption key for sensitive data
# Generate with: openssl rand -hex 32
# MUST be 64 characters (32 bytes in hex)
ENCRYPTION_KEY=CHANGE_THIS_TO_SECURE_32_BYTE_HEX_VALUE

# CSRF token expiration in seconds
# 3600 = 1 hour (prevents token reuse)
CSRF_TOKEN_EXPIRATION=3600

# Password hashing algorithm
# Options: bcrypt, argon2i, argon2id
# Recommend: argon2id (most secure)
PASSWORD_ALGORITHM=argon2id

# Password hashing cost factor (higher = slower but more secure)
# Range: 8-12 recommended
# Higher values slow down password attempts, protecting against brute force
PASSWORD_COST=10

# Allow remember-me login sessions
# Options: true, false
ALLOW_REMEMBER_ME=true

# Remember-me session duration in days
# 30 = 30 days
REMEMBER_ME_DURATION=30

################################################################################
# AUDIT & COMPLIANCE
################################################################################

# Enable audit logging - tracks all user actions
# Must be true for compliance and troubleshooting
AUDIT_LOGGING=true

# Audit log retention in days
# 365 = 1 year, recommend archiving older logs monthly
AUDIT_LOG_RETENTION=365

# Enable IP logging in audit trails
# For security investigation and fraud detection
AUDIT_LOG_IP=true

# Enable user action details in audit trails
# For troubleshooting and compliance reports
AUDIT_LOG_DETAILS=true

################################################################################
# SYSTEM SETTINGS
################################################################################

# Default timezone (PHP timezone identifier)
# Example: Asia/Manila (for Philippines)
# See: https://www.php.net/manual/en/timezones.php
TIMEZONE=Asia/Manila

# Date format for display
# Example: Y-m-d (2026-10-24)
DATE_FORMAT=Y-m-d

# Time format for display
# Example: H:i:s (14:30:45)
TIME_FORMAT=H:i:s

# Enable email notifications (Phase 2 feature)
# For now: false (email not implemented in Phase 1)
ENABLE_EMAIL=false

# SMTP configuration (if email enabled)
# SMTP_HOST=CHANGE_IF_EMAIL_ENABLED
# SMTP_PORT=587
# SMTP_USER=email@asmrcctvtechnologies.com
# SMTP_PASSWORD=smtp_password

################################################################################
# PERFORMANCE & CACHING
################################################################################

# Query cache timeout in seconds
# 3600 = 1 hour (cache dashboard queries)
CACHE_TIMEOUT=3600

# Enable database query caching
# true = cache SELECT queries, false = no caching
ENABLE_QUERY_CACHE=true

# Maximum database connection pool size
# For shared hosting, usually 5-10
DB_CONNECTION_POOL=5

################################################################################
# ERROR HANDLING
################################################################################

# Display errors to users
# MUST be false in production (prevents information disclosure)
DISPLAY_ERRORS=false

# Log errors to file
# true = write errors to log file (recommended)
LOG_ERRORS=true

# Error reporting level (PHP bitmask)
# E_ALL = report all errors
# Production: E_ALL & ~E_NOTICE (all except notices)
ERROR_REPORTING=E_ALL

################################################################################
# DEVELOPER SETTINGS (Development Only)
################################################################################

# Enable development mode features
# ONLY for local development
# MUST be false in production
ENABLE_DEV_TOOLS=false

# Display SQL queries (development only)
# Useful for optimization, creates log spam in production
SHOW_QUERIES=false

# Enable API debugging
# Shows detailed API responses and errors
DEBUG_API=false

################################################################################
# IMPORTANT SECURITY NOTES
################################################################################

# 1. NEVER store this file in version control (.gitignore it)
# 2. NEVER commit with actual credentials
# 3. ALWAYS use HTTPS (APP_URL must be https://)
# 4. ALWAYS use strong passwords (20+ characters)
# 5. CHANGE default values before deploying to production
# 6. Set file permissions: chmod 640 .env
# 7. Set owner to web server user: chown www-data:www-data .env
# 8. Backup this file separately (contains credentials)
# 9. Review configuration before each deployment
# 10. Update on-the-fly settings via administrator panel, not by editing .env

################################################################################
# CONFIGURATION CHECKLIST
################################################################################

# Before deploying to production, verify:
# [ ] DB_HOST, DB_NAME, DB_USER, DB_PASSWORD configured
# [ ] APP_URL updated to production domain
# [ ] APP_DEBUG set to false
# [ ] SESSION_SECURE set to true (for HTTPS)
# [ ] ENCRYPTION_KEY generated and changed
# [ ] LOG_DIR, UPLOAD_DIR, BACKUP_DIR exist and are writable
# [ ] File permissions set to 640
# [ ] Database backups tested and working
# [ ] HTTPS certificate verified and valid
# [ ] All paths use absolute paths (not relative)
# [ ] Session timeout appropriate for your operations
# [ ] Backup retention meets compliance requirements
# [ ] Audit logging enabled for compliance

################################################################################
# SUPPORT & TROUBLESHOOTING
################################################################################

# If database connection fails:
# 1. Verify DB_HOST is correct (localhost for shared hosting)
# 2. Check DB_USER and DB_PASSWORD in cPanel
# 3. Verify database exists: mysql -u user -p -e "SHOW DATABASES;"
# 4. Ensure user is added to database in cPanel
#
# If uploads fail:
# 1. Check UPLOAD_DIR exists and is writable: ls -la /path/to/uploads/
# 2. Verify MAX_UPLOAD_SIZE < php.ini post_max_size
# 3. Check file permissions: chmod 770 /path/to/uploads/
#
# If logging fails:
# 1. Verify LOG_DIR exists and is writable: ls -la /path/to/logs/
# 2. Check file permissions: chmod 770 /path/to/logs/
#
# For additional support, see: TROUBLESHOOTING_GUIDE.md

